@namespace MudBlazor.Docs.Examples

<MudPaper Width="300px" Elevation="0">
    <MudTreeView Items="@TreeItems" Virtualize="true" Height="300px" Hover>
        <ItemTemplate>
            <MudTreeViewItem @bind-Expanded="@context.Expanded" @bind-Selected="@context.Selected" Visible="@context.Visible"
                             Items="@context.Children" Value="@context.Value" Icon="@context.Icon" Text="@context.Text" />
        </ItemTemplate>
    </MudTreeView>
</MudPaper>

@code {
    public List<TreeItemData<string>> TreeItems { get; set; } = [];

    public class TreeItemPresenter : TreeItemData<string>
    {
        public TreeItemPresenter(string text, string icon) : base(text)
        {
            Text = text;
            Icon = icon;
        }
    }

    protected override void OnInitialized()
    {
        for (var year = 2006; year <= 2025; year++)
        {
            TreeItems.Add(new TreeItemPresenter($"Reports {year}", Icons.Material.Filled.Folder)
            {
                Expanded = true,
                Children = Enumerable
                    .Range(1, 50)
                    .Select(week => (ITreeItemData<string>)new TreeItemPresenter($"Week {week} report.pdf", Icons.Material.Filled.Description))
                    .ToList()
            });
        }
    }
}

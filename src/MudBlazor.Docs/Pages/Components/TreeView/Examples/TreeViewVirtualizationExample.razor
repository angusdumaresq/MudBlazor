@namespace MudBlazor.Docs.Examples

<MudPaper Width="300px" Elevation="0">
    <MudTreeView Items="@TreeItems" Virtualize="true" Height="300px" Hover aria-label="Organization">
        <ItemTemplate>
            <MudTreeViewItem @bind-Expanded="@context.Expanded" @bind-Selected="@context.Selected" Visible="@context.Visible"
                             Items="@context.Children" Value="@context.Value" Icon="@context.Icon" Text="@context.Text" />
        </ItemTemplate>
    </MudTreeView>
</MudPaper>

@code {
    public List<TreeItemData<string>> TreeItems { get; set; } = [];

    public class TreeItemPresenter : TreeItemData<string>
    {
        public TreeItemPresenter(string text, string icon) : base(text)
        {
            Text = text;
            Icon = icon;
        }
    }

    protected override void OnInitialized()
    {
        for (var i = 1; i <= 20; i++)
        {
            TreeItems.Add(new TreeItemPresenter($"Group_{i}", Icons.Material.Filled.Folder)
            {
                Expanded = true,
                Children = Enumerable
                    .Range(1, 50)
                    .Select(j => (ITreeItemData<string>)new TreeItemPresenter($"Value_{i}_{j}", Icons.Material.Filled.Description))
                    .ToList()
            });
        }
    }
}
